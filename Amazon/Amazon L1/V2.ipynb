test_item_df = pd.DataFrame(test_item_embeddings_pca, index=test_df.index, 
                           columns=[f'item_emb_{i}' for i in range(50)])
test_bullet_df = pd.DataFrame(test_bullet_embeddings_pca, index=test_df.index,
                             columns=[f'bullet_emb_{i}' for i in range(30)])
test_desc_df = pd.DataFrame(test_desc_embeddings_pca, index=test_df.index,
                           columns=[f'desc_emb_{i}' for i in range(20)])

# Combine test features
test_feature_df = pd.concat([
    test_df[numerical_features + binary_features].fillna(0),
    test_item_df, test_bullet_df, test_desc_df
], axis=1)

# Scale numerical features
test_feature_df[numerical_features] = scaler.transform(test_feature_df[numerical_features])

# Make predictions with each model
print("Making predictions...")
catboost_preds = final_catboost.predict(test_feature_df)
xgb_preds = final_xgb.predict(test_feature_df)
lgb_preds = final_lgb.predict(test_feature_df)

# Ensemble predictions
final_preds = 0.4 * catboost_preds + 0.3 * xgb_preds + 0.3 * lgb_preds

# Transform predictions back to original scale
final_preds_original = np.expm1(final_preds)

# Create submission file
submission = pd.DataFrame({
    'sample_id': test_df['sample_id'],
    'price': final_preds_original
})

# Save submission
submission.to_csv("/Users/bhavinbaldota/Library/CloudStorage/OneDrive-MSFT/Desktop/Amazon L1/submission_v2.csv", index=False)
