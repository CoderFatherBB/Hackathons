# ==============================
# 2. Advanced Text Cleaning
# ==============================
def clean_text(text):
    """Remove HTML, emojis, special chars, lowercase."""
    if pd.isna(text):
        return ""
    text = html.unescape(text)
    text = BeautifulSoup(text, "lxml").get_text(separator=" ")
    text = text.encode("ascii", "ignore").decode()
    text = text.lower()
    text = re.sub(r'\s+', ' ', text).strip()
    return text

# ==============================
# 3. Feature Engineering
# ==============================
def extract_features(df):
    # Clean text
    df['catalog_clean'] = df['catalog_content'].apply(clean_text)
    
    # Extract item name
    df['item_name'] = df['catalog_clean'].str.extract(r'item name: (.*?)(?=\n|$)', re.IGNORECASE).fillna('')
    
    # Extract bullet points
    bullet_pattern = r'bullet point \d+: (.*?)(?=\n|$)'
    df['bullet_points'] = df['catalog_clean'].apply(
        lambda x: ' '.join(re.findall(bullet_pattern, x, re.IGNORECASE))
    )
    
    # Extract product description
    desc_pattern = r'product description: (.*?)(?=\n|$)'
    df['product_description'] = df['catalog_clean'].str.extract(desc_pattern, re.IGNORECASE).fillna('')
    
    # Combined text for embeddings
    df['combined_text'] = df['item_name'] + ' ' + df['bullet_points'] + ' ' + df['product_description']
    
    # Extract quantity and unit
    def extract_quantity(text):
        # Look for value and unit in structured format
        value_match = re.search(r'value:\s*(\d+(?:\.\d+)?)', text, re.IGNORECASE)
        unit_match = re.search(r'unit:\s*(\w+(?:\s+\w+)*)', text, re.IGNORECASE)
        
        # Initialize qty_match outside the if blocks
        qty_match = None
        
        if value_match:
            value = float(value_match.group(1))
        else:
            # Try to find quantity in item name
            qty_match = re.search(r'(\d+(?:\.\d+)?)\s*(oz|ounce|ml|g|gram|kg|lb|pound|count|ct)', text, re.IGNORECASE)
            if qty_match:
                value = float(qty_match.group(1))
            else:
                value = np.nan
        
        if unit_match:
            unit = unit_match.group(1).lower()
        elif qty_match and not pd.isna(value):
            unit = qty_match.group(2).lower()
        else:
            unit = ""
            
        return value, unit
    
    df[['value', 'unit']] = df['catalog_clean'].apply(lambda t: pd.Series(extract_quantity(t)))
    
    # Extract pack size
    pack_patterns = [
        r'pack\s?of\s?(\d+)',
        r'(\d+)[\s-]?pack',
        r'(\d+)\s?count',
        r'(\d+)\s?ct'
    ]
    
    def extract_pack_size(text):
        for pattern in pack_patterns:
            match = re.search(pattern, text, re.IGNORECASE)
            if match:
                return int(match.group(1))
        return 1  # Default to 1 if no pack size found
    
    df['pack_size'] = df['catalog_clean'].apply(extract_pack_size)
    
    # Normalize units and calculate total quantity
    unit_map = {
        "ounce": 28.3495, "oz": 28.3495, "ounces": 28.3495,
        "fl oz": 29.5735, "fluid ounce": 29.5735, "fluid ounces": 29.5735,
        "count": 1, "ct": 1, "piece": 1, "pieces": 1,
        "ml": 1, "milliliter": 1, "milliliters": 1,
        "g": 1, "gram": 1, "grams": 1,
        "kg": 1000, "kilogram": 1000, "kilograms": 1000,
        "lb": 453.592, "pound": 453.592, "pounds": 453.592
    }
    
    df['normalized_value'] = df.apply(
        lambda row: row['value'] * unit_map.get(row['unit'].lower(), 1) if not pd.isna(row['value']) else np.nan,
        axis=1
    )
    df['total_quantity'] = df['normalized_value'] * df['pack_size']
    df['log_total_quantity'] = np.log1p(df['total_quantity'].fillna(0))
    
    # Extract brand
    def extract_brand(text):
        # First word of item name is often the brand
        if pd.isna(text) or text == '':
            return "unknown"
        
        item_name_match = re.search(r'item name: (.*?)(?=\n|$)', text, re.IGNORECASE)
        if item_name_match:
            first_word = item_name_match.group(1).split()[0]
            # Filter out common non-brand first words
            non_brands = ['the', 'a', 'an', 'new', 'premium', 'organic', 'fresh', 'natural']
            if first_word.lower() not in non_brands and len(first_word) > 1:
                return first_word
        
        return "unknown"
    
    df['brand'] = df['catalog_content'].apply(extract_brand)
    df['brand_popularity'] = df.groupby('brand')['brand'].transform('count')
    df['brand_avg_price'] = df.groupby('brand')['price'].transform('mean')
    df['brand_median_price'] = df.groupby('brand')['price'].transform('median')
    df['brand_price_std'] = df.groupby('brand')['price'].transform('std').fillna(0)
    
    # Text length features
    df['text_length'] = df['catalog_clean'].str.len()
    df['bullet_count'] = df['catalog_clean'].str.count('bullet point')
    df['word_count'] = df['catalog_clean'].str.split().str.len()
    
    # Extract categories and product types
    food_categories = ['organic', 'gluten-free', 'vegan', 'vegetarian', 'non-gmo', 'kosher', 'halal', 
                      'sugar-free', 'low-carb', 'keto', 'paleo', 'dairy-free', 'nut-free']
    
    for category in food_categories:
        df[f'is_{category.replace("-", "_")}'] = df['catalog_clean'].str.contains(category, case=False).astype(int)
    
    # Product type indicators
    product_types = ['coffee', 'tea', 'chocolate', 'candy', 'snack', 'cookie', 'sauce', 'spice', 
                    'oil', 'vitamin', 'supplement', 'protein', 'cereal', 'pasta', 'rice', 'drink',
                    'juice', 'water', 'milk', 'cheese', 'meat', 'fish', 'fruit', 'vegetable']
    
    for product in product_types:
        df[f'is_{product}'] = df['catalog_clean'].str.contains(r'\b' + product + r'\b', case=False).astype(int)
    
    # Premium indicators
    premium_words = ['premium', 'luxury', 'gourmet', 'artisan', 'craft', 'handmade', 'handcrafted', 
                    'authentic', 'traditional', 'finest', 'quality', 'exclusive', 'limited', 'special']
    
    df['premium_count'] = df['catalog_clean'].apply(
        lambda x: sum(1 for word in premium_words if re.search(r'\b' + word + r'\b', x, re.IGNORECASE))
    )
    
    return df

# Apply feature engineering
df = extract_features(df)

# ==============================
# 4. Text Embeddings
# ==============================
print("\nGenerating Sentence-BERT embeddings...")
model_bert = SentenceTransformer('all-MiniLM-L6-v2')

# Generate embeddings for different text components
item_embeddings = model_bert.encode(df['item_name'].fillna(''), batch_size=64, show_progress_bar=True)
bullet_embeddings = model_bert.encode(df['bullet_points'].fillna(''), batch_size=64, show_progress_bar=True)
desc_embeddings = model_bert.encode(df['product_description'].fillna(''), batch_size=64, show_progress_bar=True)

print("Reducing embedding dimensions...")
# PCA for item name embeddings
pca_item = PCA(n_components=50)
item_embeddings_pca = pca_item.fit_transform(item_embeddings)
item_df = pd.DataFrame(item_embeddings_pca, index=df.index, 
                      columns=[f'item_emb_{i}' for i in range(50)])

# PCA for bullet points embeddings
pca_bullet = PCA(n_components=30)
bullet_embeddings_pca = pca_bullet.fit_transform(bullet_embeddings)
bullet_df = pd.DataFrame(bullet_embeddings_pca, index=df.index,
                        columns=[f'bullet_emb_{i}' for i in range(30)])

# PCA for product description embeddings
pca_desc = PCA(n_components=20)
desc_embeddings_pca = pca_desc.fit_transform(desc_embeddings)
desc_df = pd.DataFrame(desc_embeddings_pca, index=df.index,
                      columns=[f'desc_emb_{i}' for i in range(20)])

# ==============================
# 5. Final Feature Set
# ==============================
# Numerical features
numerical_features = [
    'log_total_quantity', 'pack_size', 'brand_popularity', 'brand_avg_price',
    'brand_median_price', 'brand_price_std', 'text_length', 'bullet_count',
    'word_count', 'premium_count'
]

# Binary features - food categories and product types
binary_features = [col for col in df.columns if col.startswith('is_')]

# Combine all features
feature_df = pd.concat([
    df[numerical_features + binary_features].fillna(0),
    item_df, bullet_df, desc_df
], axis=1)

# Scale numerical features
scaler = StandardScaler()
feature_df[numerical_features] = scaler.fit_transform(feature_df[numerical_features])

# ==============================
# 6. SMAPE Metric
# ==============================
def smape(y_true, y_pred):
    y_true = np.expm1(y_true)  # back-transform
    y_pred = np.expm1(y_pred)
    return np.mean(
        np.abs(y_pred - y_true) / ((np.abs(y_true) + np.abs(y_pred)) / 2)
    ) * 100

# ==============================
# 7. Cross-Validation and Model Training
# ==============================
print("\nPerforming cross-validation...")
kf = KFold(n_splits=5, shuffle=True, random_state=42)
y = np.log1p(df['price'])  # Log transform target

# Model parameters
catboost_params = {
    'iterations': 3000,
    'learning_rate': 0.03,
    'depth': 10,
    'l2_leaf_reg': 3,
    'loss_function': 'RMSE',
    'random_seed': 42,
    'verbose': 500
}

xgb_params = {
    'max_depth': 9,
    'learning_rate': 0.03,
    'n_estimators': 3000,
    'subsample': 0.8,
    'colsample_bytree': 0.8,
    'objective': 'reg:squarederror',
    'random_state': 42,
    'verbosity': 1
}

lgb_params = {
    'objective': 'regression',
    'metric': 'rmse',
    'num_leaves': 128,
    'learning_rate': 0.03,
    'n_estimators': 3000,
    'subsample': 0.8,
    'colsample_bytree': 0.8,
    'random_state': 42,
    'verbose': 0
}

# Train models with cross-validation
cv_scores = []
catboost_models = []
xgb_models = []
lgb_models = []

for fold, (train_idx, val_idx) in enumerate(kf.split(feature_df)):
    print(f"\nTraining fold {fold+1}/5...")
    X_train, X_val = feature_df.iloc[train_idx], feature_df.iloc[val_idx]
    y_train, y_val = y.iloc[train_idx], y.iloc[val_idx]
    
    # CatBoost
    print("Training CatBoost...")
    catboost_model = CatBoostRegressor(**catboost_params)
    catboost_model.fit(X_train, y_train, eval_set=[(X_val, y_val)], early_stopping_rounds=100)
    catboost_models.append(catboost_model)
    
    # XGBoost
    print("Training XGBoost...")
    xgb_model = xgb.XGBRegressor(**xgb_params)
    xgb_model.fit(X_train, y_train, eval_set=[(X_val, y_val)], early_stopping_rounds=100, verbose=False)
    xgb_models.append(xgb_model)
    
    # LightGBM
    print("Training LightGBM...")
    lgb_model = lgb.LGBMRegressor(**lgb_params)
    lgb_model.fit(X_train, y_train, eval_set=[(X_val, y_val)], early_stopping_rounds=100, verbose=False)
    lgb_models.append(lgb_model)
    
    # Ensemble predictions
    catboost_preds = catboost_model.predict(X_val)
    xgb_preds = xgb_model.predict(X_val)
    lgb_preds = lgb_model.predict(X_val)
    
    # Simple weighted average
    ensemble_preds = 0.4 * catboost_preds + 0.3 * xgb_preds + 0.3 * lgb_preds
    
    # Calculate SMAPE
    fold_smape = smape(y_val, ensemble_preds)
    cv_scores.append(fold_smape)
    print(f"Fold {fold+1} SMAPE: {fold_smape:.4f}")

print(f"\nAverage CV SMAPE: {np.mean(cv_scores):.4f}")
print(f"Standard Deviation: {np.std(cv_scores):.4f}")

# ==============================
# 8. Final Model Training
# ==============================
print("\nTraining final models on full dataset...")

# Train final models
final_catboost = CatBoostRegressor(**catboost_params)
final_catboost.fit(feature_df, y, verbose=500)

final_xgb = xgb.XGBRegressor(**xgb_params)
final_xgb.fit(feature_df, y, verbose=False)

final_lgb = lgb.LGBMRegressor(**lgb_params)
final_lgb.fit(feature_df, y, verbose=False)

# ==============================
# 9. Feature Importance Analysis
# ==============================
print("\nTop 20 important features from CatBoost:")
feature_importance = pd.DataFrame({
    'Feature': feature_df.columns,
    'Importance': final_catboost.feature_importances_
})
print(feature_importance.sort_values('Importance', ascending=False).head(20))

