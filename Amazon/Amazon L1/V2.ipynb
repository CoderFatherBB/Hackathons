# Apply PCA transformation
test_item_embeddings_pca = pca_item.transform(test_item_embeddings)
test_bullet_embeddings_pca = pca_bullet.transform(test_bullet_embeddings)
test_desc_embeddings_pca = pca_desc.transform(test_desc_embeddings)

